{
  "manifest_version": 3,
  "name": "内网媒体联调助手",
  "version": "1.0.1",
  "description": "拖拽图片/视频生成内网 HTTP 链接",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9090/*",
    "http://localhost:9090/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
